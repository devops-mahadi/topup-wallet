# Env for running WITH the observability stack. Load it only when you want
# telemetry exported, so the core stack stays unaffected by default:
#
#   docker compose --profile observability --env-file .env.observability up -d
#
# Point the apps at the in-compose OTel Collector. (Compose's default .env is NOT
# auto-loaded when --env-file is given, so this file carries everything needed.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
